{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": false,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@*": [".src*"],
      "@rilldataweb-common*": ["..web-commonsrc*"],
      "@rilldataweb-admin*": ["..web-adminsrc*"]
    }
  },
  "include": ["src***"]
}
