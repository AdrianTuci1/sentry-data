{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": false,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@statsparrot/web-common/*": ["../web-common/src/*"],
      "@statsparrot/web-admin/*": ["../web-admin/src/*"]
    }
  },
  "include": ["src/**/*"]
}
