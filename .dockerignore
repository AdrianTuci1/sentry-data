# Dependency installs (installed inside the image; never copy host node_modules).
node_modules
**/node_modules

# Frontend/build outputs (regenerated by `npm run build` inside the image).
**/build
**/dist
**/.svelte-kit
**/.next

# Test coverage and tool caches.
**/coverage
**/.cache
**/.turbo

# Version control metadata.
**/.git
**/.gitignore

# Editor and OS cruft.
**/.DS_Store
**/*.swp
**/*.tmp

# Local environment files (secrets are injected at runtime).
**/.env
**/.env.*
